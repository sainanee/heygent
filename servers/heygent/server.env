# Non-secret settings for heygent (apps/server/src/config.ts in Parley). NAME=value, no quotes.
# Secrets (DATABASE_URL, PARLEY_SECRET_KEY) never go here: scripts/set-secrets.sh.
PARLEY_DOMAIN=heygent.fly.dev
PARLEY_PUBLIC_URL=https://heygent.fly.dev
PARLEY_MODE=production
PARLEY_OPERATOR_CONTACT=https://github.com/sainanee/heygent/issues
PARLEY_CLIENT_IP_HEADER=fly-client-ip
PARLEY_SIGN_IN=passkey
# Claude's client metadata, pinned: claude.ai answers 403 to Fly's addresses (Parley's operator guide, section 8).
# Fetched from claude.ai and checked with `cli.ts cimd:pin` on 2026-10-24.
PARLEY_CIMD_PINS={"https://claude.ai/oauth/mcp-oauth-client-metadata":{"client_id":"https://claude.ai/oauth/mcp-oauth-client-metadata","client_name":"Claude","redirect_uris":["https://claude.ai/api/mcp/auth_callback"]}}
